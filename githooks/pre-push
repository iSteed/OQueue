#!/usr/bin/env bash
# Pre-push hook: blocks pushing to main if src/ or build.js changed since
# origin/main without build.js's // @version being bumped. See
# scripts/check-version-bump.js for the why and the actual comparison logic.
#
# Not run automatically unless this repo's core.hooksPath points at this
# directory - see the "Development" section in README.md to opt in.
set -euo pipefail

remote="$1"
pushing_to_main=false

# Git feeds one line per ref being pushed on stdin:
#   <local ref> <local sha1> <remote ref> <remote sha1>
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    pushing_to_main=true
  fi
done

if [ "$pushing_to_main" != true ]; then
  exit 0
fi

git fetch origin main --quiet || true
node "$(dirname "$0")/../scripts/check-version-bump.js" origin/main HEAD
